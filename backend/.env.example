# Copy this file to .env and fill in your own values. Never commit .env.

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub webhook secret (set the same value when creating the webhook on a repo)
GITHUB_WEBHOOK_SECRET=

# Gemini API key, free tier, no credit card required (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Random secret used to sign JWT auth tokens issued to the React frontend.
# Generate one with: ruby -rsecurerandom -e "puts SecureRandom.hex(64)"
JWT_SECRET=

# React dev server origin, used for CORS
FRONTEND_URL=http://localhost:5173
